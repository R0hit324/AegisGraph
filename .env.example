# =============================================================================
# AegisGraph — Environment Configuration (EXAMPLE)
# =============================================================================
# Copy this file to `.env` in the project root:
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# SECURITY RULES
# - Never commit a real `.env` (it is already git-ignored).
# - Never place API keys, database passwords, or private credentials in the
#   FRONTEND environment (any `VITE_*` value is exposed to the browser).
# - See SECURITY.md and README.md for details.
#
# OPTIONAL BUG / INTELLIGENCE PROVIDER KEYS (future phases) must be added as
# BACKEND_* variables below. AegisGraph must start WITHOUT them.
# =============================================================================

# ---------------------------------------------------------------- Application
# Runtime environment: development | production
APP_ENV=development

# Application version reported by the health endpoint.
APP_VERSION=0.1.0

# Application secret. Used for future signing use cases (e.g. sessions).
# REQUIRED to be a strong random value (>= 32 chars) when APP_ENV=production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-only-secret-change-before-any-production-deployment

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------- Database
# Docker Compose injects these into the PostgreSQL container (db service).
# They also feed the backup/restore scripts in scripts/.
POSTGRES_DB=aegisgraph
POSTGRES_USER=aegisgraph
# Change before any hosted deployment. Local-only dev default is acceptable
# ONLY because the database port is not published to the network by default.
POSTGRES_PASSWORD=change-me-local-dev-only

# SQLAlchemy connection URL used by the backend (must use the +psycopg driver).
# Inside Docker Compose the host is `db`. For non-Docker local development use
# `localhost` instead:
#   postgresql+psycopg://aegisgraph:change-me-local-dev-only@localhost:5432/aegisgraph
DATABASE_URL=postgresql+psycopg://aegisgraph:change-me-local-dev-only@db:5432/aegisgraph

# ------------------------------------------------------------------- Backend
# Explicit CORS allowlist (comma-separated, no wildcards). "http://localhost:3000"
# is the local frontend. Add your own origins if you change ports.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------- Frontend
# Backend base URL the browser uses to call the API.
# NOTE (SECURITY): everything prefixed VITE_ is bundled into the public
# JavaScript and readable by anyone who opens the app. Only non-secret values
# belong here.
VITE_API_BASE_URL=http://localhost:8000

# ============================================ OPTIONAL — future provider keys
# Intentionally left empty. AegisGraph must fully start without these.
# Docs describing each credential format will be added with its phase.
# BACKEND_CENSYS_API_ID=
# BACKEND_CENSYS_API_SECRET=
# BACKEND_NVD_API_KEY=
